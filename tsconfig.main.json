{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true,
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "noEmit": true, "types": ["node"]
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"]
}
