{
  "name": "db-ex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DB EX — local-first database explorer for MySQL, MongoDB and Redis",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:main && npm run build:preload && electron . --dev\"",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/main.cjs --packages=external --external:electron",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/preload.cjs --external:electron",
    "build": "npm run build:main && npm run build:preload && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "mongodb": "^6.15.0",
    "mysql2": "^3.12.0",
    "redis": "^4.7.0",
    "ssh2": "^1.16.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.4",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "dev.dbex.desktop",
    "productName": "DB EX",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
