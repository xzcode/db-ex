{
  "name": "db-ex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DB EX — local-first database explorer for MySQL, MariaDB, MongoDB, Redis, SQLite and ClickHouse",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "predev": "npm run icons",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:main && npm run build:preload && electron . --dev\"",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/main.cjs --packages=external --external:electron && esbuild src/main/operations/sqlite-worker.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/sqlite-worker.cjs --packages=external",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/preload.cjs --external:electron",
    "build": "npm run icons && npm run build:main && npm run build:preload && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/db-integration.test.ts tests/redis-integration.test.ts tests/session-integration.test.ts",
    "test:ui": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "test:topology": "node --import tsx --test tests/mongo-topology.test.ts tests/redis-topology.test.ts",
    "icons": "node scripts/generate-icons.mjs",
    "pretest:ui": "node -e \"if (!require('fs').existsSync('build/icon-brand.png')) require('child_process').execFileSync(process.execPath,['scripts/generate-icons.mjs'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "@clickhouse/client": "^1.25.0",
    "acorn": "^8.19.0",
    "exceljs": "4.4.0",
    "hyparquet": "1.33.2",
    "hyparquet-writer": "0.18.1",
    "ioredis": "^5.11.1",
    "monaco-editor": "^0.57.0",
    "mongodb": "^6.15.0",
    "mysql2": "^3.12.0",
    "papaparse": "^5.7.1",
    "prettier": "^3.10.1",
    "saxes": "6.0.0",
    "socks": "^2.8.11",
    "sql-formatter": "^15.10.0",
    "ssh2": "^1.16.0",
    "vue": "^3.5.13",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.5.2",
    "@types/ssh2": "^1.15.4",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vue-tsc": "^2.2.4",
    "wait-on": "^8.0.2"
  },
  "overrides": {
    "dompurify": "^3.5.0",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "dev.dbex.desktop",
    "productName": "DB EX",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icons/db-ex.png"
      },
      {
        "from": "build/icon-mac.png",
        "to": "icons/db-ex-mac.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist-electron/sqlite-worker.cjs"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "notarize": false,
      "icon": "build/icon.icns",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "xzcode",
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "DB-EX-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "homepage": "https://github.com/xzcode/db-ex",
  "repository": {
    "type": "git",
    "url": "https://github.com/xzcode/db-ex.git"
  },
  "author": "xzcode"
}
